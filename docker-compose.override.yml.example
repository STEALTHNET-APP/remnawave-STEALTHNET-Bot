###############################################################################
#  Локальный override для удобной диагностики на dev-машине.
#  Скопируй в `docker-compose.override.yml` (он в .gitignore) — Compose сам
#  подмерджит к основному файлу. На проде НЕ включай — открывает Postgres
#  снаружи контейнерной сети.
###############################################################################
services:
  postgres:
    # Биндим Postgres только на 127.0.0.1, чтобы порт не торчал в инет.
    # Подключение: psql -h 127.0.0.1 -p 5432 -U stealthnet -d stealthnet
    ports:
      - "127.0.0.1:5432:5432"

  # Опционально: expose API напрямую без nginx — для swagger / тестов
  # api:
  #   ports:
  #     - "127.0.0.1:5000:5000"
